# Settings for a loadout registry, read by `loadout serve` from its environment.
#
# Copy this file, fill it in with your editor, and keep it private:
#
#   install -m 600 deploy/loadout.env.example loadout.env
#
# Then deploy with LOADOUT_ENV_FILE=loadout.env (deploy.sh installs it as
# /etc/loadout/loadout.env, readable by root only). Every line is optional and
# commented out; remove the # in front of the ones you need. Unset is safe: a
# registry with none of them serves the token API and nothing else.
#
# Check the file before it is used (it prints one line per part, never a
# password, and fails on a variable loadout does not read, such as a typo):
#
#   loadout serve --check --env-file loadout.env
#
# Syntax: KEY=VALUE, one per line, no spaces around =, no export. A value with
# spaces or # goes in one pair of quotes. Nothing in this file is run or
# expanded.

# --- Web and CLI login ---------------------------------------------------

# The registry's address in a browser. Without it there are no web pages, no
# `loadout login` and no sign-up; people join with invites and tokens.
# LOADOUT_PUBLIC_URL=https://registry.example.com

# --- Email sign-up and sign-in: an SMTP provider -------------------------
# loadout sends mail through any provider that offers SMTP submission with
# STARTTLS (SES, Resend, Postmark, Brevo, Mailgun, your own relay). All four
# of host, user, password and sender are needed to turn email on.

# The provider's SMTP host.
# LOADOUT_SMTP_HOST=smtp.example.com
# The submission port. Default 587.
# LOADOUT_SMTP_PORT=587
# The SMTP user name your provider gave you.
# LOADOUT_SMTP_USER=
# The SMTP password or API key. A secret: type it here yourself.
# LOADOUT_SMTP_PASSWORD=
# The sender of login mails. Its domain must be one your provider has verified.
# LOADOUT_MAIL_FROM="loadout <login@example.com>"
# Log login mails instead of sending them (for a trial without a mail provider).
# LOADOUT_DEV=1

# --- Other ways to sign in -----------------------------------------------

# Google sign-in. Both or neither. The OAuth client's redirect URI is
# {LOADOUT_PUBLIC_URL}/auth/google/callback.
# LOADOUT_GOOGLE_CLIENT_ID=
# LOADOUT_GOOGLE_CLIENT_SECRET=

# Simple login: email and password only, no mail, no Google, no sign-up.
# You give each person a password with `loadout user password --email E` on
# the host. For a registry with no mail provider.
# LOADOUT_LOGIN=simple
#
# In simple login, the first start of an empty registry creates one admin,
# admin@loadout.local, so you can sign in at once. Without the next line its
# password is made up and printed once to the service's log (read it with
# `journalctl -u loadout`; change it afterwards with `loadout user password`).
# With it, that password is used and never printed. 12 to 128 characters, not
# a common one, or the service refuses to start. Used only while the registry
# has no account at all; set it before the first start, remove it after.
# LOADOUT_ADMIN_PASSWORD=

# --- Behind a proxy that is not on this machine --------------------------
# A container platform, tunnel or load balancer that connects to loadout
# itself. Without these, every request looks like it comes from the proxy.
# Both or neither.

# The addresses or ranges the proxy connects from, separated by commas.
# LOADOUT_TRUSTED_PROXIES=203.0.113.0/24
# The header the proxy puts the client's single address in: Fly-Client-IP,
# CF-Connecting-IP, True-Client-IP or X-Real-IP. Not X-Forwarded-For.
# LOADOUT_CLIENT_IP_HEADER=Fly-Client-IP

# --- Pages and the admins' server page -----------------------------------

# Where the pages' Docs and What's new links go. For a registry without
# internet access; unset points at the project's site.
# LOADOUT_DOCS_URL=https://docs.example.com/loadout/

# What the Host panel of the server page says about the machine. Plain text.
# LOADOUT_HOST_PROVIDER=Example Cloud
# LOADOUT_HOST_REGION=eu-1
# LOADOUT_HOST_SIZE=2 vCPU, 4 GB memory
# LOADOUT_HOST_CONTACT=ops@example.com
# An https link to the host's console.
# LOADOUT_HOST_CONSOLE=https://console.example.com/

# Only on a Hetzner Cloud server: a read-only API token of its project adds the
# server, traffic and cost panels. A secret.
# LOADOUT_HETZNER_TOKEN=
# The server's id or name. Unset finds it by this machine's public IPv4.
# LOADOUT_HETZNER_SERVER=
