[Unit]
Description=loadout registry
Documentation=https://github.com/petervlad/loadout
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=loadout
Group=loadout
Environment=HOME=/var/lib/loadout
Environment=LOADOUT_LOG=info
# Where loadout-backup.sh writes; the admins' server page lists it (read only).
Environment=LOADOUT_BACKUP_DIR=/var/backups/loadout
# Login settings and secrets (LOADOUT_PUBLIC_URL, LOADOUT_SMTP_*, ...), if
# deploy.sh installed them. systemd reads the file as root before dropping
# to the loadout user, so it stays root:root 0600. "-": optional.
EnvironmentFile=-/etc/loadout/loadout.env
ExecStart=/usr/local/bin/loadout serve --data /var/lib/loadout --addr 127.0.0.1:7420
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

# /var/lib/loadout, owned by loadout, created by systemd.
StateDirectory=loadout
StateDirectoryMode=0750
UMask=0077

# Hardening. Check with: systemd-analyze security loadout
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/loadout
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
